{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [ "${mod_author}" ],
  "contact": {},

  "license": "${license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.boxadactle.coordinatesdisplay.fabric.CoordinatesDisplayFabric"
    ],
    "modmenu": [
      "dev.boxadactle.coordinatesdisplay.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "coordinatesdisplay.mixins.json",
    "coordinatesdisplay.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft_version_range_fabric}",
    "boxlib": "${boxlib_version_range_fabric}"
  }
}
